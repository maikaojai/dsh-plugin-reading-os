{
  "name": "dsh-plugin-reading-os",
  "version": "2.2.2",
  "description": "ReadingOS · macOS 本地图书划线与阅读记录插件，支持与 DeepSeek 对话联动",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "author": "maikaojai",
  "repository": {
    "type": "git",
    "url": "https://github.com/maikaojai/dsh-plugin-reading-os.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "reading",
    "reading-os",
    "books"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
